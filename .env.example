# --- App ---
APP_NAME="IT Support Agent"
APP_ENV=development

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Fallback LLMs ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- LangSmith tracing ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=it-support
LANGSMITH_AGENT_ENVIRONMENT=development

# --- External search ---
TAVILY_API_KEY=

# --- Vector DB (Pinecone) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=fde-rag-copilot
PINECONE_NAMESPACE=company-it-kb

# --- Embeddings (local, no API key) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval / agent ---
TOP_K=5

# --- Conversation memory ---
REDIS_URL=redis://localhost:6379/0
CONVERSATION_TTL_SECONDS=86400

# --- Security ---
ADMIN_API_KEY=change-me
