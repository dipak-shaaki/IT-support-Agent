# --- App ---
APP_NAME="IT Support Agent"
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Fallback LLMs ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- LangSmith tracing ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=it-support
LANGSMITH_AGENT_ENVIRONMENT=development

# --- External search ---
TAVILY_API_KEY=

# --- Vector DB (Pinecone) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=fde-rag-copilot
PINECONE_NAMESPACE=company-it-kb

# --- Embeddings (local, no API key) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Retrieval / agent ---
TOP_K=5

# --- Conversation memory ---
REDIS_URL=redis://localhost:6379/0
CONVERSATION_TTL_SECONDS=86400

# --- Security ---
ADMIN_API_KEY=change-me
MAX_UPLOAD_BYTES=26214400
# none (local/dev) or proxy (trusted reverse proxy sets AUTH_USER_HEADER)
AUTH_MODE=none
AUTH_USER_HEADER=X-Auth-Request-User
AUTH_ROLES_HEADER=X-Auth-Request-Roles
# Comma-separated proxy roles that grant admin access (proxy mode only)
AUTH_ADMIN_ROLES=
RATE_LIMIT_PER_MINUTE=30
LLM_TIMEOUT_SECONDS=60

# --- Document ingestion ---
# inline (default) or queue (requires the worker service; see compose.yaml)
INGEST_MODE=inline
INGEST_JOB_TTL_SECONDS=86400
# A running job is requeued if its worker lease expires (seconds).
INGEST_LEASE_SECONDS=300
# Stop retrying a stalled job after this many attempts.
INGEST_MAX_ATTEMPTS=3
